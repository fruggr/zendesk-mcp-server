{
  "name": "@fruggr/zendesk-mcp-server",
  "version": "3.13.0",
  "mcpName": "io.github.fruggr/zendesk-mcp-server",
  "description": "Deep Zendesk MCP server for your AI assistant: search, draft, update and translate Help Center articles and manage Support tickets end to end — comments, triage and image attachments.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zendesk-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "glama.json"
  ],
  "scripts": {
    "build": "tsdown",
    "build:server-json": "node scripts/build-server-json.mjs > server.json",
    "typecheck": "node scripts/typecheck.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx src/index.ts --transport http --host 127.0.0.1 --port 3000 --public-url http://localhost:3000 --mode all --namespace all",
    "prepare": "npm run build && (lefthook install || true)",
    "prepublishOnly": "npm run build",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:canary": "node scripts/mutation-canary.mjs",
    "test:mutation:diff": "node scripts/mutation-scope.mjs diff",
    "test:mutation:summary": "node scripts/mutation-scope.mjs summary",
    "test:mutation:static": "node scripts/mutation-scope.mjs static",
    "test:smoke": "pnpm build && node scripts/smoke-test.mjs",
    "test:bundle": "pnpm build && vitest run --config vitest.bundle.config.ts",
    "bundle:size": "pnpm build && node scripts/bundle-size.mjs",
    "mcp:live": "tsx scripts/mcp-live.ts",
    "tool-definitions:report": "tsx scripts/tool-definitions-report.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "mcp-server",
    "zendesk",
    "zendesk-api",
    "zendesk-support",
    "help-center",
    "knowledge-base",
    "customer-support",
    "customer-service",
    "help-desk",
    "support-tickets",
    "oauth2",
    "pkce",
    "llm",
    "ai",
    "claude",
    "anthropic",
    "cli"
  ],
  "author": "Digital4Better <hello@digital4better.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fruggr/zendesk-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/fruggr/zendesk-mcp-server/issues"
  },
  "homepage": "https://github.com/fruggr/zendesk-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.15.0",
    "@types/oidc-provider": "9.13.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cheerio": "1.2.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "hast-util-to-html": "9.0.7",
    "hast-util-to-mdast": "10.1.3",
    "jose": "6.2.18",
    "lefthook": "^2.2.2",
    "mcp-tdqs": "0.2.0",
    "msw": "^3.0.0",
    "oidc-provider": "~9.15.0",
    "open": "11.0.4",
    "rehype-parse": "9.0.1",
    "rehype-raw": "7.0.0",
    "rehype-remark": "10.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "semantic-release": "^25.0.3",
    "shx": "^0.4.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0",
    "typescript-legacy": "npm:typescript@6.0.3",
    "unified": "11.0.5",
    "vitest": "^5.0.0",
    "zod": "4.6.7"
  }
}
