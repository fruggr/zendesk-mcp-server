# Required
ZENDESK_SUBDOMAIN=mycompany

# --- Local (stdio, default) — OAuth 2.1 PKCE by default ---
# OAuth client id, defaults to ${ZENDESK_SUBDOMAIN}_zendesk
# ZENDESK_OAUTH_CLIENT_ID=your_client_id

# --- Local (stdio) — API token escape hatch for CI/headless only ---
# Refused at boot in HTTP mode (would equate to a public MCP with shared rights).
# ZENDESK_EMAIL=agent@company.com
# ZENDESK_API_TOKEN=your_api_token

# --- Remote (HTTP) — per-user OAuth 2.1 PKCE only ---
# TRANSPORT=http
# HOST=0.0.0.0
# PORT=3000
# Public URL clients use to reach this server (required when behind a TLS
# reverse proxy: Azure App Service, Heroku, Fly, Cloudflare Tunnel, nginx...).
# Azure App Service: PUBLIC_URL=https://${WEBSITE_HOSTNAME}
# PUBLIC_URL=https://mcp.example.com

# Optional
# LOG_LEVEL=info
