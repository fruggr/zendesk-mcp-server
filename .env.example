# Required
ZENDESK_SUBDOMAIN=mycompany

# --- Local (stdio, default) — OAuth 2.1 PKCE ---
# OAuth client id, defaults to ${ZENDESK_SUBDOMAIN}_zendesk
# ZENDESK_OAUTH_CLIENT_ID=your_client_id

# --- Remote (HTTP) — per-user OAuth 2.1 PKCE ---
# TRANSPORT=http
# HOST=0.0.0.0
# PORT=3000
# Public URL clients use to reach this server (required when behind a TLS
# reverse proxy: Azure App Service, Heroku, Fly, Cloudflare Tunnel, nginx...).
# Azure App Service: PUBLIC_URL=https://${WEBSITE_HOSTNAME}
# PUBLIC_URL=https://mcp.example.com
# Extra browser origins allowed by CORS (comma-separated). The default
# allowlist (chatgpt.com, claude.ai, gemini.google.com, copilot.microsoft.com,
# perplexity.ai, chat.mistral.ai, grok.com, localhost-any-port) is always
# applied — this list adds to it.
# CORS_ORIGIN=https://internal-dashboard.example.com,https://team-portal.example.com

# Optional
# LOG_LEVEL=info
