{
  "mcpServers": {
    "zendesk-local": {
      "command": "pnpm",
      "args": ["exec", "tsx", "src/index.ts", "--mode", "all", "--dev", "--namespace", "all"],
      "env": {
        "ZENDESK_SUBDOMAIN": "fruggr"
      }
    },
    "zendesk-local-http": {
      "type": "http",
      "url": "http://localhost:3000/mcp"
    },
    "zendesk-local-http-admin": {
      "type": "http",
      "url": "http://localhost:3000/mcp/admin"
    }
  }
}
