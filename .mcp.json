{
  "mcpServers": {
    "zendesk-local": {
      "command": "pnpm",
      "args": [
        "exec",
        "tsx",
        "src/index.ts",
        "--mode",
        "all",
        "--dev",
        "--namespace",
        "tickets",
        "--namespace",
        "help_center",
        "--namespace",
        "users",
        "--namespace",
        "requests"
      ],
      "env": {
        "ZENDESK_SUBDOMAIN": "fruggr"
      }
    },
    "zendesk-local-http": {
      "type": "http",
      "url": "http://localhost:3000/mcp"
    }
  }
}
